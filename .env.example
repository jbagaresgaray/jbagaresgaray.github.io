# Contact form settings (docs/contact-form.md).
# Local development: copy to .env.local, or run `vercel env pull .env.local`.
# Vercel: set these in Project → Settings → Environment Variables.

# Resend API key with "Sending access". Server-only; never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g.
# CONTACT_FROM_EMAIL="Portfolio Contact Form <contact@yourdomain.com>"
# Leave empty to use Resend's test sender. Emails then go only to your Resend
# account's address (dev.philipcesar@gmail.com) instead of both recipients.
CONTACT_FROM_EMAIL=

# Origins allowed to call the API cross-origin (comma-separated). Defaults to the
# GitHub Pages site, https://jbagaresgaray.github.io. Set on Vercel only if that changes.
# CONTACT_ALLOWED_ORIGINS=https://jbagaresgaray.github.io

# Where the form posts. Leave unset to use this app's own /api/contact. The GitHub Pages
# build sets it from the CONTACT_ENDPOINT repository variable (.github/workflows/deploy.yml).
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://your-project.vercel.app/api/contact
